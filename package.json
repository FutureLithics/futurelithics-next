{
  "name": "futurelithics-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "env -u PLAYWRIGHT_BROWSERS_PATH playwright test",
    "test:e2e:ui": "env -u PLAYWRIGHT_BROWSERS_PATH playwright test --ui",
    "test:e2e:install": "env -u PLAYWRIGHT_BROWSERS_PATH playwright install chromium",
    "test:all": "npm run test && npm run test:e2e"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/react-fontawesome": "^0.2.2",
    "bootstrap": "^5.3.5",
    "d3": "^7.9.0",
    "final-form": "^4.20.10",
    "font-awesome": "^4.7.0",
    "next": "15.3.1",
    "nodemailer": "^7.0.3",
    "react": "^19.0.0",
    "react-bootstrap": "^2.10.9",
    "react-dom": "^19.0.0",
    "react-final-form": "^6.5.9",
    "reactstrap": "^9.2.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^20",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9",
    "eslint-config-next": "15.3.1",
    "jsdom": "^29.1.1",
    "sass": "^1.87.0",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11"
  }
